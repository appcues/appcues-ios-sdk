{"kind":"project","sections":[{"chapter":"Permission Primers","estimatedTimeInMinutes":30,"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial creates a permission primer for camera usage, but the same process can be used for other protected resources."}]}],"title":"Creating a Camera Permission Primers","kind":"hero"},{"tasks":[{"contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"Configure your app to report the permission status as an Appcues profile attribute and configure the Appcues iOS SDK to be able to trigger the permission prompt."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing"}],"anchor":"In-app-configuration","title":"In-app configuration","stepsSection":[{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Add a "},{"code":"NSCameraUsageDescription","type":"codeVoice"},{"type":"text","text":" to your Info.plist."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"code":"PermissionPrimers-01-01.plist","caption":[{"inlineContent":[{"type":"text","text":"To use protected device resources, a usage description for the resource must be provided, and the permission request must be triggered. If no usage description is provided in your apps Info.plist file, your app will be rejected during App Store review."}],"type":"paragraph"}]},{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Create an extension on "},{"code":"AVAuthorizationStatus","type":"codeVoice"},{"type":"text","text":" to get a standardized, human-readable string for each possible status."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"code":"PermissionPrimers-01-02.swift","caption":[{"inlineContent":[{"type":"text","text":"This status value will be used for the Appcues user profile property."}],"type":"paragraph"}]},{"type":"step","content":[{"inlineContent":[{"type":"text","text":"Update your existing "},{"code":"Appcues.identify()","type":"codeVoice"},{"type":"text","tex
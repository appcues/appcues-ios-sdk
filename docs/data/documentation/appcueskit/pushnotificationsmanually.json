{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appcueskit\/pushnotificationsmanually"]}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"There are two options for configuring push notification: automatic or manual."}],"type":"paragraph"},{"type":"aside","content":[{"inlineContent":[{"text":"Automatic configuration is the quickest and simplest way to configure push notifications and is recommended for most customers. Refer to ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/PushNotifications","isActive":true},{"text":" for automatic configuration instructions.","type":"text"}],"type":"paragraph"}],"name":"Tip","style":"tip"},{"inlineContent":[{"type":"text","text":"Follow in tutorial form with "},{"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/tutorials\/AppcuesKit\/PushNotificationsTutorial","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Prerequisites","anchor":"Prerequisites","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is recommended to have "},{"type":"reference","identifier":"https:\/\/docs.appcues.com\/en_US\/push-notifications\/push-notification-settings","isActive":true},{"type":"text","text":" before configuring push notifications in your app to allow you quickly test your configuration end to end."}]},{"type":"heading","text":"Manual App Configuration","anchor":"Manual-App-Configuration","level":2},{"type":"heading","text":"Step 1. Enable push capabilities","anchor":"Step-1-Enable-push-capabilities","level":3},{"inlineContent":[{"type":"text","text":"In Xcode, navigate to the Signing & Capabilities section of your main app target and add the Push Notifications capability."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Step 2. Register for push notifications","anchor":"Step-2-Register-for-push-notifications"},{"code":["\/\/ AppDelegate.swift","","func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","    application.registerForRemoteNotifications()","","    \/\/ ...","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Step 3. Set push token for Appcues","anchor":"Step-3-Set-push-token-for-Appcues"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/setPushToken(_:)"},{"type":"text","text":" from "},{"type":"codeVoice","code":"UIApplicationDelegate.application(_:didRegisterForRemoteNotificationsWithDeviceToken:)"},{"type":"text","text":" to pass the APNs token from calling "},{"type":"codeVoice","code":"registerForRemoteNotifications()"},{"type":"text","text":" to Appcues."}],"type":"paragraph"},{"code":["\/\/ AppDelegate.swift","","func application(_ application: UIApplication, didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {","    appcuesInstance.setPushToken(deviceToken)","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Step 4. Enable push response handling","anchor":"Step-4-Enable-push-response-handling"},{"inlineContent":[{"type":"text","text":"Update your "},{"type":"codeVoice","code":"AppDelegate"},{"type":"text","text":" to conform to the "},{"type":"codeVoice","code":"UNUserNotificationCenterDelegate"},{"type":"text","text":" protocol and assign "},{"type":"codeVoice","code":"self"},{"type":"text","text":" the delegate in "},{"type":"codeVoice","code":"application(_:didFinishLaunchingWithOptions:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Implement "},{"type":"codeVoice","code":"userNotificationCenter(_:didReceive:withCompletionHandler:)"},{"type":"text","text":" and pass the received notification response to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/didReceiveNotification(response:completionHandler:)"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ AppDelegate.swift","","@main","class AppDelegate: UIResponder, UIApplicationDelegate, UNUserNotificationCenterDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        application.registerForRemoteNotifications()","        UNUserNotificationCenter.current().delegate = self","","        \/\/ ...","    }","","    func userNotificationCenter(_ center: UNUserNotificationCenter, didReceive response: UNNotificationResponse, withCompletionHandler completionHandler: @escaping () -> Void) {","        if appcuesInstance.didReceiveNotification(response: response, completionHandler: completionHandler) {","            \/\/ NOTE: Appcues calls the completion handler if the notification is an Appcues notification.","            return","        }","","        completionHandler()","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"Step 5. Configure foreground handling","anchor":"Step-5-Configure-foreground-handling"},{"inlineContent":[{"type":"text","text":"Configure handling of push notifications received while your app is in the foreground by implementing "},{"type":"codeVoice","code":"userNotificationCenter(_:willPresent:withCompletionHandler:)"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ AppDelegate.swift","","func userNotificationCenter(_ center: UNUserNotificationCenter, willPresent notification: UNNotification, withCompletionHandler completionHandler: @escaping (UNNotificationPresentationOptions) -> Void) {","    completionHandler([.banner, .list])","}"],"syntax":"swift","type":"codeListing"}]}],"identifie
{"metadata":{"role":"article","modules":[{"name":"AppcuesKit"}],"roleHeading":"Article","title":"Configuring the Appcues URL Scheme"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","identifier":{"url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/URLSchemeConfiguring","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Configuring the Appcues URL scheme involves adding a ","type":"text"},{"code":"CFBundleURLTypes","type":"codeVoice"},{"text":" value and then directing the incoming URL to the Appcues iOS SDK.","type":"text"}]},{"content":[{"inlineContent":[{"text":"It is ","type":"text"},{"inlineContent":[{"text":"strongly","type":"text"}],"type":"strong"},{"text":" recommended that you configure the custom URL scheme. It allows non-developer users of your Appcues instance to test Appcues experiences in a real setting. It’s also valuable for future troubleshooting and support from Appcues via the debugger.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"text":"Register the Custom URL Scheme","anchor":"Register-the-Custom-URL-Scheme","level":2,"type":"heading"},{"inlineContent":[{"text":"Update your ","type":"text"},{"type":"codeVoice","code":"Info.plist"},{"text":" to register the custom URL scheme. Replace ","type":"text"},{"type":"codeVoice","code":"APPCUES_APPLICATION_ID"},{"text":" in the snippet below with your app’s Appcues Application ID. This value can be obtained from your ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/studio.appcues.com\/settings\/installation"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, if your Appcues Application ID is ","type":"text"},{"type":"codeVoice","code":"123-xyz"},{"text":" your url scheme value would be ","type":"text"},{"type":"codeVoice","code":"appcues-123-xyz"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["<key>CFBundleURLTypes<\/key>","<array>","    <dict>","        <key>CFBundleTypeRole<\/key>","        <string>Editor<\/string>","        <key>CFBundleURLName<\/key>","        <string>$(PRODUCT_BUNDLE_IDENTIFIER)<\/string>","        <key>CFBundleURLSchemes<\/key>","        <array>","            <string>appcues-APPCUES_APPLICATION_ID<\/string>","        <\/array>","    <\/dict>","<\/array>"],"type":"codeListing"},{"text":"Handle the Custom URL Scheme","anchor":"Handle-the-Custom-URL-Scheme","level":2,"type":"heading"},{"inlineContent":[{"text":"Custom URL’s should be handled with a call to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/filterAndHandle(_:)"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/didHandleURL(_:)"},{"text":". If the URL being opened is an Appcues URL, the URL will be handled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your app uses a Scene delegate, add the following:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {","    \/\/ Handle Appcues deep links.","    let unhandledURLContexts = appcues.filterAndHandle(connectionOptions.urlContexts)","","    \/\/ Handle any links remaining in unhandledURLContexts.","}","","func scene(_ scene: UIScene, openURLContexts URLContexts: Set<UIOpenURLContext>) {","    \/\/ Handle Appcues deep links.","    let unhandledURLContexts = appcues.filterAndHandle(URLContexts)","","    \/\/ Handle any links remaining in unhandledURLContexts.","}"],"type":"codeListing"},{"inlineContent":[{"text":"If your app uses only an App delegate, add the following:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["func application(_ application: UIApplication, open url: URL, options: [UIApplication.OpenURLOptionsKey : Any] = [:] ) -> Bool {","    \/\/ Handle Appcues deep links.","    guard !appcues.didHandleURL(url) else { return true }","","    \/\/ Handle a non-Appcues URL.","    return false","}"],"type":"codeListing"},{"inlineContent":[{"text":"A SwiftUI app can handle the custom URL scheme as part of the ","type":"text"},{"type":"codeVoice","code":"onOpenURL"},{"text":" modifier associated with the ","type":"text"},{"type":"codeVoice","code":"Scene"},{"text":" of your main ","type":"text"},{"type":"codeVoice","code":"App"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var body: some Scene {","    WindowGroup {","        MyApp()","        .onOpenURL { url in","            guard !appcues.didHandleURL(url) else { return }","        }","    }","}"],"type":"codeListing"},{"text":"Verifying the Custom URL Scheme","anchor":"Verifying-the-Custom-URL-Scheme","level":2,"type":"heading"},{"inlineContent":[{"text":"The Appcues debugger allows you to easily validate that the Appcues deep link is properly configured.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch the debugger in your app with a call to ","type":"text"},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/debug()","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Expand the debugger by tapping the floating button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tap the “Appcues Deep Link Configured” row to verify the status. If a checkmark appears, the Appcues deep link is properly configured.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","anchor":"Troubleshooting","level":3,"text":"Troubleshooting"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Error 0"},{"text":": The Appcues debugger was unable to set up the verification test.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Error 1","type":"codeVoice"},{"text":": The ","type":"text"},{"code":"CFBundleURLSchemes","type":"codeVoice"},{"text":" value is missing. Refer to the “Register the Custom URL Scheme” section above.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Error 2"},{"text":": The URL scheme is registered, but the Appcues SDK did not receive the link from the host app. Refer to the “Handle the Custom URL Scheme” section above.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Error 3","type":"codeVoice"},{"text":": The Appcues SDK received the link, but the verification token value was unexpected. Testing again should resolve the issue.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Debugging","isActive":true,"type":"reference"},{"text":" for details on the functionality of the debugger.","type":"text"}]}]}],"abstract":[{"type":"text","text":"The Appcues iOS SDK includes support for a custom URL scheme that supports previewing Appcues experiences in-app prior to publishing and launching the Appcues debugger."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit"]]},"seeAlsoSections":[{"generated":true,"anchor":"Core-Functionality","title":"Core Functionality","identifiers":["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/GettingStarted","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Identifying","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Tracking","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AnchoredTooltips","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/PushNotifications","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appcueskit\/urlschemeconfiguring"]}],"references":{"doc://com.appcues.sdk/documentation/AppcuesKit":{"kind":"symbol","abstract":[{"type":"text","text":"Appcues iOS SDK allows you to integrate Appcues experiences into your native iOS and iPadOS apps."}],"type":"topic","title":"AppcuesKit","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit","role":"collection","url":"\/documentation\/appcueskit"},"doc://com.appcues.sdk/documentation/AppcuesKit/Identifying":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"In order to target content to the right users at the right time, you need to identify users and send Appcues data about them."}],"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Identifying","role":"article","title":"Identifying and Managing Users","url":"\/documentation\/appcueskit\/identifying"},"doc://com.appcues.sdk/documentation/AppcuesKit/Debugging":{"abstract":[{"type":"text","text":"The Appcues debugger is an in-app overlay that provides debug information in an accessible manner."}],"role":"article","url":"\/documentation\/appcueskit\/debugging","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Debugging","kind":"article","type":"topic","title":"Using the Appcues Debugger"},"doc://com.appcues.sdk/documentation/AppcuesKit/Appcues/debug()":{"type":"topic","url":"\/documentation\/appcueskit\/appcues\/debug()","kind":"symbol","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/debug()","role":"symbol","abstract":[{"text":"Launches the Appcues debugger over your app’s UI.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"debug","kind":"identifier"},{"text":"()","kind":"text"}],"title":"debug()"},"doc://com.appcues.sdk/documentation/AppcuesKit/Appcues":{"kind":"symbol","title":"Appcues","abstract":[{"type":"text","text":"An object that manag
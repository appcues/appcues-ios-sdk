{"hierarchy":{"paths":[["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit"]]},"identifier":{"url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/URLSchemeConfiguring","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The Appcues iOS SDK includes support for a custom URL scheme that supports previewing Appcues experiences in-app prior to publishing and launching the Appcues debugger."}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Configuring the Appcues URL scheme involves adding a ","type":"text"},{"type":"codeVoice","code":"CFBundleURLTypes"},{"text":" value and then directing the incoming URL to the Appcues iOS SDK.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is "},{"type":"strong","inlineContent":[{"text":"strongly","type":"text"}]},{"type":"text","text":" recommended that you configure the custom URL scheme. It allows non-developer users of your Appcues instance to test Appcues experiences in a real setting. It’s also valuable for future troubleshooting and support from Appcues via the debugger."}]}],"style":"note","name":"Note","type":"aside"},{"level":2,"anchor":"Register-the-Custom-URL-Scheme","text":"Register the Custom URL Scheme","type":"heading"},{"inlineContent":[{"text":"Update your ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":" to register the custom URL scheme. Replace ","type":"text"},{"code":"APPCUES_APPLICATION_ID","type":"codeVoice"},{"text":" in the snippet below with your app’s Appcues Application ID. This value can be obtained from your ","type":"text"},{"identifier":"https:\/\/studio.appcues.com\/settings\/installation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, if your Appcues Application ID is ","type":"text"},{"type":"codeVoice","code":"123-xyz"},{"text":" your url scheme value would be ","type":"text"},{"type":"codeVoice","code":"appcues-123-xyz"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["<key>CFBundleURLTypes<\/key>","<array>","    <dict>","        <key>CFBundleTypeRole<\/key>","        <string>Editor<\/string>","        <key>CFBundleURLName<\/key>","        <string>$(PRODUCT_BUNDLE_IDENTIFIER)<\/string>","        <key>CFBundleURLSchemes<\/key>","        <array>","            <string>appcues-APPCUES_APPLICATION_ID<\/string>","        <\/array>","    <\/dict>","<\/array>"],"syntax":null,"type":"codeListing"},{"level":2,"anchor":"Handle-the-Custom-URL-Scheme","text":"Handle the Custom URL Scheme","type":"heading"},{"inlineContent":[{"type":"text","text":"Custom URL’s should be handled with a call to "},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/filterAndHandle(_:)","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/didHandleURL(_:)","type":"reference","isActive":true},{"type":"text","text":". If the URL being opened is an Appcues URL, the URL will be handled."}],"type":"paragraph"},{"inlineContent":[{"text":"If your app uses a Scene delegate, add the following:","type":"text"}],"type":"paragraph"},{"code":["func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {","    \/\/ Handle Appcues deep links.","    let unhandledURLContexts = appcues.filterAndHandle(connectionOptions.urlContexts)","","    \/\/ Handle any links remaining in unhandledURLContexts.","}","","func scene(_ scene: UIScene, openURLContexts URLContexts: Set<UIOpenURLContext>) {","    \/\/ Handle Appcues deep links.","    let unhandledURLContexts = appcues.filterAndHandle(URLContexts)","","    \/\/ Handle any links remaining in unhandledURLContexts.","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If your app uses only an App delegate, add the following:"}],"type":"paragraph"},{"code":["func application(_ application: UIApplication, open url: URL, options: [UIApplication.OpenURLOptionsKey : Any] = [:] ) -> Bool {","    \/\/ Handle Appcues deep links.","    guard !appcues.didHandleURL(url) else { return true }","","    \/\/ Handle a non-Appcues URL.","    return false","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A SwiftUI app can handle the custom URL scheme as part of the "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":" modifier associated with the "},{"type":"codeVoice","code":"Scene"},{"type":"text","text":" of your main "},{"type":"codeVoice","code":"App"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var body: some Scene {","    WindowGroup {","        MyApp()","        .onOpenURL { url in","            guard !appcues.didHandleURL(url) else { return }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Verifying the Custom URL Scheme","anchor":"Verifying-the-Custom-URL-Scheme"},{"inlineContent":[{"type":"text","text":"The Appcues debugger allows you to easily validate that the Appcues deep link is properly configured."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Launch the debugger in your app with a call to ","type":"text"},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/debug()","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Expand the debugger by tapping the floating button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tap the “Appcues Deep Link Configured” row to verify the status. If a checkmark appears, the Appcues deep link is properly configured."}]}]}]},{"anchor":"Troubleshooting","level":3,"text":"Troubleshooting","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Error 0","type":"codeVoice"},{"text":": The Appcues debugger was unable to set up the verification test.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Error 1"},{"type":"text","text":": The "},{"type":"codeVoice","code":"CFBundleURLSchemes"},{"type":"text","text":" value is missing. Refer to the “Register the Custom URL Scheme” section above."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Error 2","type":"codeVoice"},{"text":": The URL scheme is registered, but the Appcues SDK did not receive the link from the host app. Refer to the “Handle the Custom URL Scheme” section above.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"Error 3","type":"codeVoice"},{"text":": The Appcues SDK received the link, but the verification token value was unexpected. Testing again should resolve the issue.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Debugging"},{"type":"text","text":" for details on the functionality of the debugger."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appcueskit\/urlschemeconfiguring"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"AppcuesKit"}],"roleHeading":"Article","role":"article","title":"Configuring the Appcues URL Scheme"},"seeAlsoSections":[{"anchor":"Core-Functionality","generated":true,"identifiers":["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/GettingStarted","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Identifying","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Tracking","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AnchoredTooltips","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/PushNotifications","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues"],"title":"Core Functionality"}],"kind":"article","references":{"doc://com.appcues.sdk/documentation/AppcuesKit/PushNotifications":{"kind":"article","url":"\/documentation\/appcueskit\/pushnotifications","type":"topic","abstract":[{"text":"The Appcues iOS SDK supports receiving push notification so you can reach your users whenever the moment is right.","type":"text"}],"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/PushNotifications","title":"Configuring Push Notifications","role":"article"},"doc://com.appcues.sdk/documentation/AppcuesKit/Identifying":{"type":"topic","url":"\/documentation\/appcueskit\/identifying","abstract":[{"text":"In order to target content to the right users at the right time, you need to identify users and send Appcues data about them.","type":"text"}],"kind":"article","role":"article","title":"Identifying and Managing Users","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Identifying"},"doc://com.appcues.sdk/documentation/AppcuesKit/GettingStarted":{"type":"topic","url":"\/documentation\/appcueskit\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Initialize the SDK and track events."}],"role":"article","title":"Getting Started with Appcues iOS SDK","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/GettingStarted"},"doc://com.appcues.sdk/documentation/AppcuesKit":{"type":"topic","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit","role":"collection","url":"\/documentation\/appcueskit","abstract":[{"text":"Appcues iOS SDK allows you to integrate Appcues experiences into your native iOS and iPadOS apps.","type":"text"}],"title":"AppcuesKit","kind":"symbol"},"doc://com.appcues.sdk/documentation/AppcuesKit/Tracking":{"type":"topic","url":"\/documentation\/appcueskit\/tracking","abstract":[{"text":"Events are the “actions” your users take in your application, which can be anything from
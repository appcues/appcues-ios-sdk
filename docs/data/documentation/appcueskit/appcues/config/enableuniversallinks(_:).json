{"kind":"symbol","identifier":{"url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/Config\/enableUniversalLinks(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"enableUniversalLinks"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"enabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Self"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether universal link handling is enabled."}]}],"name":"enabled"}]},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"Configuration","type":"codeVoice"},{"type":"text","text":" object."}]}],"kind":"content"},{"mentions":["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/UniversalLinking"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"When this property is enabled, the SDK will pass web links that are triggered by an experience back to the host","type":"text"},{"text":" ","type":"text"},{"text":"application to process. The host application should implement the ","type":"text"},{"code":"application(_:continue:restorationHandler:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in its ","type":"text"},{"code":"ApplicationDelegate","type":"codeVoice"},{"text":" to return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if the link provided in the given ","type":"text"},{"code":"NSUserActivity","type":"codeVoice"},{"text":" has been handled","type":"text"},{"text":" ","type":"text"},{"text":"as a universal link inside the current application, or ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":" if not. When a value of "},{"type":"codeVoice","code":"true"},{"type":"text","text":" is returned, this informs the SDK"},{"type":"text","text":" "},{"type":"text","text":"that no further link handling is needed. When a value of "},{"type":"codeVoice","code":"false"},{"type":"text","text":" is returned, the SDK will continue handling the link and open"},{"type":"text","text":" "},{"type":"text","text":"the web destination in the browser."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When this property is disabled, any web links triggered by an experience will always be opened in the browser, regardless of","type":"text"},{"text":" ","type":"text"},{"text":"whether it was a universal link that may have been intended to deep link to another screen in the app.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default value for this configuration is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":".","type":"text"}]}],"kind":"content"}],"metadata":{"role":"symbol","externalID":"s:10AppcuesKit0A0C6ConfigC20enableUniversalLinksyAEXDSbF","roleHeading":"Instance Method","modules":[{"name":"AppcuesKit"}],"symbolKind":"method","title":"enableUniversalLinks(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"enableUniversalLinks","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":") -> ","kind":"text"},{"text":"Self","kind":"typeIdentifier"}]},"sections":[],"abstract":[{"type":"text","text":"Set the universal link handling preference for the configuration."}],"variants":[{"paths":["\/documentation\/appcues
{"sections":[],"abstract":[{"text":"Learn more about changes to Appcues iOS SDK.","type":"text"}],"metadata":{"role":"article","title":"Migration Guide","modules":[{"name":"AppcuesKit"}],"roleHeading":"Article"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/MigrationGuide"},"hierarchy":{"paths":[["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Appcues iOS SDK follow semantic versions. Accordingly, a major version is incremented when an incompatible API change is made. Below are details for each such version change."}],"type":"paragraph"},{"anchor":"4x-to-50-Migration-Guide","level":2,"text":"4.x to 5.0 Migration Guide","type":"heading"},{"anchor":"Overview","level":3,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Updating to this release will not require any code changes for most SDK installations. Code changes would only be required if your app implemented a custom element targeting strategy.","type":"text"}],"type":"paragraph"},{"anchor":"Changed","level":3,"text":"Changed","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesElementTargeting\/captureLayout()"},{"text":" is now async.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"3x-to-40-Migration-Guide","level":2,"text":"3.x to 4.0 Migration Guide","type":"heading"},{"inlineContent":[{"text":"There are no no code changes required. SDK version 4 introduced support for push notifications.","type":"text"}],"type":"paragraph"},{"anchor":"2x-to-30-Migration-Guide","level":2,"text":"2.x to 3.0 Migration Guide","type":"heading"},{"anchor":"Overview","level":3,"text":"Overview",
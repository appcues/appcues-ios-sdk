{"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Appcues iOS SDK follow semantic versions. Accordingly, a major version is incremented when an incompatible API change is made. Below are details for each such version change."}]},{"anchor":"4x-to-50-Migration-Guide","level":2,"type":"heading","text":"4.x to 5.0 Migration Guide"},{"anchor":"Overview","level":3,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Updating to this release will not require any code changes for most SDK installations. Code changes would only be required if your app implemented a custom element targeting strategy."}]},{"anchor":"Changed","level":3,"type":"heading","text":"Changed"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesElementTargeting\/captureLayout()"},{"text":" is now async.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"3x-to-40-Migration-Guide","level":2,"type":"heading","text":"3.x to 4.0 Migration Guide"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are no no code changes required. SDK version 4 introduced support for push notifications."}]},{"anchor":"2x-to-30-Migration-Guide","level":2,"type":"heading","text":"2.x to 3.0 Migration Guide"},{"anchor":"Overview","level":3,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Updating to this release will not require any code changes for most SDK installations.  Code changes would only be required if your app implemented custom experience traits or actions."}]},{"anchor":"General-Changes","level":3,"type":"heading","text":"General Changes"},{"anchor":"Removed","level":4,"type":"heading","text":"Removed"},{"type":"unorderedList","items":[{"content":[{"inlineContent
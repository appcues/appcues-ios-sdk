{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"AppcuesKit"}],"role":"article","title":"Configuring Handling of Universal Links"},"kind":"article","identifier":{"url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/UniversalLinking","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"You must implement "},{"type":"codeVoice","code":"UIApplicationDelegate.application(_:continue:restorationHandler:)"},{"type":"text","text":" to handle your universal links. By default, the Appcues iOS SDK will call this method for every "},{"type":"codeVoice","code":"https"},{"type":"text","text":" link it tries to open to allow your app a chance to handle it internally instead of opening the link in a browser. Optionally, you may provide an allow list of URL hosts—refer to the Domain Allow List section below."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"If your app has opted into ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uikit\/app_and_environment\/scenes","isActive":true,"type":"reference"},{"text":", you still must implement the ","type":"text"},{"code":"UIApplicationDelegate","type":"codeVoice"},{"text":" method to handle universal links triggered from the Appcues iOS SDK.","type":"text"}]}],"type":"aside"},{"level":2,"type":"heading","text":"Implementing the NSUserActivity Handler","anchor":"Implementing-the-NSUserActivity-Handler"},{"inlineContent":[{"type":"text","text":"Your implementation of "},{"type":"codeVoice","code":"UIApplicationDelegate.application(_:continue:restorationHandler:)"},{"type":"text","text":" must return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if you’ve successfully handled the link and "},{"type":"codeVoice","code":"false"},{"type":"text","text":" otherwise."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If needed, you can identify links coming from the Appcues iOS SDK by a "},{"type":"codeVoice","code":"referrer"},{"type":"text","text":" property in the "},{"type":"codeVoice","code":"NSUserActivity.userInfo"},{"type":"text","text":" dictionary."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppDelegate.swift","","func application(_ application: UIApplication,","                 continue userActivity: NSUserActivity,","                 restorationHandler: @escaping ([UIUserActivityRestoring]?) -> Void) -> Bool","{","","    \/\/ Get URL components from the incoming user activity.","    guard userActivity.activityType == NSUserActivityTypeBrowsingWeb,","        let incomingURL = userActivity.webpageURL else {","        return false","    }","","    if userActivity.userInfo?[\"referrer\"] as? String == \"Appcues\" {","        \/\/ This userActivity was trigged from the Appcues iOS SDK.","    }","","    \/\/ TODO: Parse the `incomingURL` here and return true if the link has been handled, false otherwise.","}"]},{"level":2,"type":"heading","text":"Implementing a Domain Allow List","anchor":"Implementing-a-Domain-Allow-List"},{"inlineContent":[{"type":"text","text":"You may define a custom key, "},{"type":"codeVoice","code":"AppcuesUniversalLinkHostAllowList"},{"type":"text","text":", in your "},{"type":"emphasis","inlineContent":[{"text":"Info.plist","type":"text"}]},{"type":"text","text":" file with an array of (string) host values to control which URLs are passed to "},{"type":"codeVoice","code":"UIApplicationDelegate.application(_:continue:restorationHandler:)"},{"type":"text","text":". A URL whose host matches any of the provided host values will be treated as a potential universal link."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An empty array will prevent all links from be treated as universal links and is functionally the same as calling "},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/Config\/enableUniversalLinks(_:)","isActive":true,"type":"reference"},{"text":" with a ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" argument.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the "},{"code":"AppcuesUniversalLinkHostAllowList","type":"codeVoice"},{"type":"text","text":" key is absent from "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":", all "},{"code":"https","type":"codeVoice"},{"type":"text","text":" links will be treated as potential universal links."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example "},{"type":"emphasis","inlineContent":[{"text":"Info.plist","type":"text"}]},{"type":"text","text":" to only treat links to "},{"code":"appcues.com","type":"codeVoice"},{"type":"text","text":" as universal links:"}],"type":"paragraph"},{"code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\" \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    ...","    <key>AppcuesUniversalLinkHostAllowList<\/key>","    <array>","        <string>appcues.com<\/string>","    <\/array>","<\/dict>","<\/plist>"],"type":"codeListing","syntax":"plist"}],"kind":"content"}],"abstract":[{"type":"text","text":"The Appcues iOS SDK supports universal links as an option for deep linking to screens within your app."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit"]]},"seeAlsoSections":[{"anchor":"Navigation","identifiers":["doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/HandlingNavigation","doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesNavigationDelegate"],"title":"Navigation","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/appcueskit\/universallinking"]}],"references":{"https://developer.apple.com/documentation/
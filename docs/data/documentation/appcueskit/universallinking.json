":"text","text":", in your "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Info.plist"}]},{"type":"text","text":" file with an array of (string) host values to control which URLs are passed to "},{"type":"codeVoice","code":"UIApplicationDelegate.application(_:continue:restorationHandler:)"},{"type":"text","text":". A URL whose host matches any of the provided host values will be treated as a potential universal link."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An empty array will prevent all links from be treated as universal links and is functionally the same as calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/Appcues\/Config\/enableUniversalLinks(_:)"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"false"},{"type":"text","text":" argument."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the "},{"type":"codeVoice","code":"AppcuesUniversalLinkHostAllowList"},{"type":"text","text":" key is absent from "},{"type":"codeVoice","code":"Info.plist"},{"text":", all ","type":"text"},{"type":"codeVoice","code":"https"},{"text":" links will be treated as potential universal links.","type":"text"}]},{"inlineContent":[{"text":"Example ","type":"text"},{"inlineContent":[{"type":"text","text":"Info.plist"}],"type":"emphasis"},{"text":" to only treat links to ","type":"text"},{"code":"appcues.com","type":"codeVoice"},{"text":" as universal links:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"plist","code":["<?xml version=\"1.0\" encoding=\"UTF-8\"?>","<!DOCTYPE plist PUBLIC \"-\/\/Apple\/\/DTD PLIST 1.0\/\/EN\" \"http:\/\/www.apple.com\/DTDs\/PropertyList-1.0.dtd\">","<plist version=\"1.0\">","<dict>","    ...","    <key>AppcuesUniversalLinkHostAllowList<\/key>","    <array>","        <string>appcues.com<\/string>","    <\/array>","<\/dict>","<\/plist>"]}]}],"sections":[],"references":{"https://developer.apple.com/documentation/
{"kind":"article","identifier":{"url":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/CustomComponentConfiguring","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Define a custom component to be rendered in an experience."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesCustomComponentViewController","type":"reference","isActive":true},{"type":"text","text":" allows your app to define a custom component that can be rendered in an experience containing a custom component block using the registered "},{"code":"identifier","type":"codeVoice"},{"type":"text","text":" for the component."}],"type":"paragraph"},{"anchor":"Implementing-a-custom-component","level":2,"text":"Implementing a custom component","type":"heading"},{"inlineContent":[{"type":"text","text":"Conform a "},{"type":"codeVoice","code":"UIViewController"},{"type":"text","text":" to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesCustomComponentViewController"},{"type":"text","text":" protocol by implementing an initializer, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesCustomComponentViewController\/init(configuration:actionController:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The initializer provides a "},{"type":"reference","identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesExperiencePluginConfiguration","isActive":true},{"type":"text","text":" object which includes a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.appcues.sdk\/documentation\/AppcuesKit\/AppcuesExperiencePluginConfiguration\/decode(_:)"},{"type":"text","text":" method to deserialize the component configurat